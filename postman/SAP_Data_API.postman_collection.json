{
  "info": {
    "name": "SAP Data API Collection",
    "_postman_id": "sap-data-api-collection",
    "description": "All endpoints for Custom SAP Data API (pull & push) and Push Back API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "custom_api_url", "value": "http://localhost:5001", "type": "string" },
    { "key": "push_back_url", "value": "http://localhost:5000", "type": "string" }
  ],
  "item": [
    {
      "name": "Custom API (Port 5001)",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{custom_api_url}}/health",
            "description": "Check if the Custom SAP Data API is running"
          }
        },
        {
          "name": "List All Services",
          "request": {
            "method": "GET",
            "url": "{{custom_api_url}}/services",
            "description": "List all 500 available SAP OData services"
          }
        },
        {
          "name": "Search Services",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{custom_api_url}}/services?search=SALES",
              "query": [{ "key": "search", "value": "SALES" }]
            },
            "description": "Search services by keyword (e.g. SALES, PRODUCT, MATERIAL)"
          }
        },
        {
          "name": "List Entities in Service",
          "request": {
            "method": "GET",
            "url": "{{custom_api_url}}/services/ZAPI_SALES_ORDER_SRV/entities",
            "description": "List all entity sets inside a SAP service"
          }
        },
        {
          "name": "Pull - Sales Orders",
          "request": {
            "method": "POST",
            "url": "{{custom_api_url}}/pull",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_path\": \"/sap/opu/odata/sap/API_SALES_ORDER_SRV\",\n  \"entity_name\": \"A_SalesOrder\",\n  \"top\": 10,\n  \"save_to_db\": true,\n  \"called_by\": \"postman_test\"\n}"
            },
            "description": "Pull Sales Order data from SAP and save to sap_data table"
          }
        },
        {
          "name": "Pull - Business Partners",
          "request": {
            "method": "POST",
            "url": "{{custom_api_url}}/pull",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_path\": \"/sap/opu/odata/sap/API_BUSINESS_PARTNER\",\n  \"entity_name\": \"A_BusinessPartner\",\n  \"top\": 10,\n  \"save_to_db\": true,\n  \"called_by\": \"postman_test\"\n}"
            },
            "description": "Pull Business Partner data from SAP"
          }
        },
        {
          "name": "Pull - Products",
          "request": {
            "method": "POST",
            "url": "{{custom_api_url}}/pull",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_path\": \"/sap/opu/odata/sap/API_PRODUCT_SRV\",\n  \"entity_name\": \"A_Product\",\n  \"top\": 10,\n  \"save_to_db\": true,\n  \"called_by\": \"postman_test\"\n}"
            },
            "description": "Pull Product data from SAP"
          }
        },
        {
          "name": "Pull - With Filter",
          "request": {
            "method": "POST",
            "url": "{{custom_api_url}}/pull",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_path\": \"/sap/opu/odata/sap/API_SALES_ORDER_SRV\",\n  \"entity_name\": \"A_SalesOrder\",\n  \"top\": 20,\n  \"filters\": \"SalesOrderType eq 'OR'\",\n  \"save_to_db\": false,\n  \"called_by\": \"postman_test\"\n}"
            },
            "description": "Pull with OData filter - only OR type sales orders"
          }
        },
        {
          "name": "Push - Update Sales Order",
          "request": {
            "method": "POST",
            "url": "{{custom_api_url}}/push/update",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_path\": \"/sap/opu/odata/sap/API_SALES_ORDER_SRV\",\n  \"entity_with_key\": \"A_SalesOrder('2')\",\n  \"mata_id\": \"2\",\n  \"payload\": {\n    \"PurchaseOrderByCustomer\": \"POSTMAN_UPDATE_001\"\n  },\n  \"called_by\": \"postman_test\"\n}"
            },
            "description": "Update an existing Sales Order in SAP"
          }
        },
        {
          "name": "Push - Create New Record",
          "request": {
            "method": "POST",
            "url": "{{custom_api_url}}/push",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_path\": \"/sap/opu/odata/sap/API_SALES_ORDER_SRV\",\n  \"entity_name\": \"A_SalesOrder\",\n  \"mata_id\": \"NEW001\",\n  \"payload\": {\n    \"SalesOrderType\": \"OR\",\n    \"SalesOrganization\": \"1710\",\n    \"DistributionChannel\": \"10\",\n    \"OrganizationDivision\": \"00\"\n  },\n  \"called_by\": \"postman_test\"\n}"
            },
            "description": "Create a new record in SAP"
          }
        },
        {
          "name": "View All Logs",
          "request": {
            "method": "GET",
            "url": "{{custom_api_url}}/logs",
            "description": "View all pull/push operation logs"
          }
        },
        {
          "name": "Filter Logs - SUCCESS only",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{custom_api_url}}/logs?status=SUCCESS",
              "query": [{ "key": "status", "value": "SUCCESS" }]
            }
          }
        },
        {
          "name": "Filter Logs - PULL only",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{custom_api_url}}/logs?operation=PULL",
              "query": [{ "key": "operation", "value": "PULL" }]
            }
          }
        },
        {
          "name": "Get Log by ID",
          "request": {
            "method": "GET",
            "url": "{{custom_api_url}}/logs/1",
            "description": "View a single operation log by ID"
          }
        }
      ]
    },
    {
      "name": "Push Back API (Port 5000)",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{push_back_url}}/health"
          }
        },
        {
          "name": "Push - Create Record",
          "request": {
            "method": "POST",
            "url": "{{push_back_url}}/push",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_path\": \"/sap/opu/odata/sap/API_SALES_ORDER_SRV\",\n  \"entity_name\": \"A_SalesOrder\",\n  \"mata_id\": \"TEST001\",\n  \"payload\": {\n    \"SalesOrderType\": \"OR\",\n    \"SalesOrganization\": \"1710\"\n  },\n  \"pushed_by\": \"postman_test\"\n}"
            }
          }
        },
        {
          "name": "Push - Update Record",
          "request": {
            "method": "POST",
            "url": "{{push_back_url}}/push/update",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_path\": \"/sap/opu/odata/sap/API_SALES_ORDER_SRV\",\n  \"entity_with_key\": \"A_SalesOrder('2')\",\n  \"mata_id\": \"2\",\n  \"payload\": {\n    \"PurchaseOrderByCustomer\": \"POSTMAN_PUSH_BACK\"\n  },\n  \"pushed_by\": \"postman_test\"\n}"
            }
          }
        },
        {
          "name": "View Push Status",
          "request": {
            "method": "GET",
            "url": "{{push_back_url}}/push/status"
          }
        },
        {
          "name": "Filter Push - SUCCESS",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{push_back_url}}/push/status?status=SUCCESS",
              "query": [{ "key": "status", "value": "SUCCESS" }]
            }
          }
        },
        {
          "name": "Get Push by ID",
          "request": {
            "method": "GET",
            "url": "{{push_back_url}}/push/status/9",
            "description": "View push ID 9 (the SUCCESS one)"
          }
        }
      ]
    }
  ]
}
