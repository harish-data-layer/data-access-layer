# ============================================
# TranAI DAL - Environment Configuration
# ============================================

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/tranai_dal?schema=public"
DB_POOL_MIN=2
DB_POOL_MAX=10

# API Configuration
API_HOST=0.0.0.0
API_PORT=3000
API_RATE_LIMIT=100
API_RATE_WINDOW=60000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tranai-dal
KAFKA_GROUP_ID=tranai-dal-consumer
KAFKA_TOPICS_EVENTS=dal.events
KAFKA_TOPICS_PUSH=dal.push
KAFKA_TOPICS_PULL=dal.pull

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# HashiCorp Vault Configuration
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-token
VAULT_NAMESPACE=tranai

# SAP Configuration
SAP_HOST=sap.example.com
SAP_PORT=443
SAP_CLIENT=100
SAP_USER=SAPUSER
SAP_PASSWORD=encrypted-password
SAP_ODATA_BASE_URL=https://sap.example.com:443/sap/opu/odata/sap

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=tranai-dal
OTEL_TRACES_SAMPLER=always_on

# Prometheus Configuration
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Data Quality Configuration
DQ_THRESHOLD_COMPLETENESS=0.95
DQ_THRESHOLD_ACCURACY=0.98
DQ_THRESHOLD_CONSISTENCY=0.95
DQ_THRESHOLD_VALIDITY=0.99
DQ_THRESHOLD_TIMELINESS=0.90
DQ_THRESHOLD_UNIQUENESS=0.99

# Vector Database Configuration
VECTOR_DIMENSION=1536
VECTOR_SIMILARITY_THRESHOLD=0.8

# Audit Configuration
AUDIT_RETENTION_DAYS=2555
AUDIT_LOG_ALL_READS=false
AUDIT_LOG_ALL_WRITES=true

# Feature Flags
FEATURE_SEMANTIC_VERSIONING=true
FEATURE_EVENT_SOURCING=true
FEATURE_PUSH_APPROVAL=true
FEATURE_AI_EMBEDDINGS=true

# External Services
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_TOKEN=your-openmetadata-token

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
